#!/bin/sh /etc/rc.common

# must come after nginx!
START=85

is_ra_enabled() {
  # Direct check on common UCI paths
  [ "$(uci -q get web.state_remote.enabled)" = "1" ] && return 0
  [ "$(uci -q get web.remote.active)" = "1" ] && return 0
  [ "$(uci -q get web.assistance.@remote.active)" = "1" ] && return 0
  # Regex check on uci show web covering quotes and unquoted values
  uci show web 2>/dev/null | grep -qE "(state_.*|assist_state.*|remote.*)\.(enabled|active)=['\"]?1['\"]?" && return 0
  return 1
}

trigger_ra() {
  # Wait for nginx to respond, retrying in background
  local retries=0
  while [ $retries -lt 30 ]; do
    if wget -O /dev/null -q http://127.0.0.1/ 2>/dev/null || curl -s -m 2 http://127.0.0.1/ >/dev/null 2>&1; then
      # Ensure firewall rules are applied once assistance datafile is created
      if [ -d /var/run/assistance ]; then
        [ -x /etc/fwdassist.sh ] && /etc/fwdassist.sh >/dev/null 2>&1
      fi
      return 0
    fi
    sleep 2
    retries=$((retries + 1))
  done
  return 1
}

boot() {
  if is_ra_enabled; then
    trigger_ra &
  fi
}

start() {
  if is_ra_enabled; then
    trigger_ra &
  fi
}

stop() {
  if [ -x /etc/fwdassist.sh ] && [ -d /var/run/assistance ]; then
    for datafile in /var/run/assistance/*; do
      [ -f "$datafile" ] || continue
      sed -i 's/^enabled=.*/enabled=0/' "$datafile"
    done
    /etc/fwdassist.sh >/dev/null 2>&1
  fi
}
