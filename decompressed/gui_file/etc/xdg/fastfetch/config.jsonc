{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    {
      "type": "cpu",
      "temp": false
    },
    {
      "type": "memory"
    },
    "swap",
    "disk",
    "break",
    "colors"
  ]
}
